local function mk(cls, props)
    local o = Instance.new(cls)
    for k, v in pairs(props) do
        if k ~= "Parent" then o[k] = v end
    end
    if props.Parent then o.Parent = props.Parent end
    return o
end
local function crn(p, r) return mk("UICorner", {CornerRadius = typeof(r)=="UDim" and r or UDim.new(0,r), Parent=p}) end
local function strk(p, c, t, tr) return mk("UIStroke", {Color=c, Thickness=t or 1, Transparency=tr or 0.3, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Parent=p}) end
local function grd(p, c1, c2, rot, tr) return mk("UIGradient", {Color=ColorSequence.new(c1,c2), Rotation=rot or 90, Transparency=tr or NumberSequence.new(0), Parent=p}) end
local function grdSeq(p, seq, rot, ts) return mk("UIGradient", {Color=seq, Rotation=rot or 90, Transparency=ts or NumberSequence.new(0), Parent=p}) end
local function pad(p, t, r, b, l) r=r or t; b=b or t; l=l or r
    return mk("UIPadding", {PaddingTop=UDim.new(0,t), PaddingRight=UDim.new(0,r), PaddingBottom=UDim.new(0,b), PaddingLeft=UDim.new(0,l), Parent=p})
end
local function tw(o, t, props, s, d)
    local info = TweenInfo.new(t, s or Enum.EasingStyle.Quart, d or Enum.EasingDirection.Out)
    local t2 = TweenService:Create(o, info, props); t2:Play(); return t2
end

