local activeTab = nil
local function showPage(name)
    for n, p in pairs(pages) do
        if n ~= name and p.Visible then
            local t = tw(p, 0.16, {GroupTransparency = 1})
            t.Completed:Connect(function() p.Visible = false end)
        end
    end
    local target = pages[name]
    if target then
        target.Visible = true
        target.GroupTransparency = 1
        target.Position = UDim2.new(0, 8, 0, 0)
        tw(target, 0.30, {GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0)})
    end
end
local function setActiveTab(name)
    if activeTab == name then return end
    activeTab = name
    for n, d in pairs(tabData) do
        local on = (n == name)
        tw(d.btn, 0.22, {TextColor3 = on and C.text or C.dim})
        tw(d.bg, 0.22, {BackgroundTransparency = on and 0 or 1})
    end
    showPage(name)
end
