local function spawnPetal()
    if #petalPool == 0 then return end
    local s = table.remove(petalPool)

    local size   = math.random(8, 22)
    local aspect = math.random(120, 180) / 100
    local startX = math.random(-15, 115) / 100
    local pal    = PETAL_PALETTE[math.random(1, #PETAL_PALETTE)]

    s.container.Size = UDim2.fromOffset(size, size * aspect)
    s.container.Position = UDim2.fromScale(startX, -0.10)
    s.container.Rotation = math.random(0, 360)

    s.wideTopGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, pal[1]),
        ColorSequenceKeypoint.new(0.35, pal[2]),
        ColorSequenceKeypoint.new(0.72, pal[3]),
        ColorSequenceKeypoint.new(1.00, pal[4]),
    })
    s.wideTopGrad.Rotation = math.random(0, 360)

    s.narrowGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, pal[1]),
        ColorSequenceKeypoint.new(0.55, pal[2]),
        ColorSequenceKeypoint.new(1.00, pal[3]),
    })

    s.wideTop.BackgroundColor3   = pal[2]
    s.narrowBottom.BackgroundColor3 = pal[1]
    s.feather.BackgroundColor3    = pal[2]
    s.featherGrad.Color = ColorSequence.new(pal[1], pal[3])
    s.innerShadow.ImageColor3 = pal[1]

    table.insert(petalActive, {
        shell = s,
        x = startX, y = -0.10,
        vy = (math.random(7, 15)) / 100,
        drift = (math.random(-30, 30)) / 100,
        rot = s.container.Rotation,
        vrot = math.random(-80, 80),
        swayAmp = math.random(18, 60) / 1000,
        swaySpeed = math.random(80, 200) / 100,
        swayPhase = math.random() * math.pi * 2,
        spinPhase = math.random() * math.pi * 2,
        spinSpeed = math.random(60, 180) / 100,
        life = 0, maxLife = math.random(90, 150) / 10,
        aspect = aspect, size = size,
    })
end

RunService.Heartbeat:Connect(function(dt)
    if math.random() < dt * 24 and #petalActive < PETAL_MAX then spawnPetal() end
    for i = #petalActive, 1, -1 do
        local p = petalActive[i]
        local s = p.shell

        p.life += dt
        p.y += p.vy * dt
        p.x += p.drift * dt
        p.rot += p.vrot * dt
        p.swayPhase += p.swaySpeed * dt
        p.spinPhase += p.spinSpeed * dt

        local wScale = math.abs(math.cos(p.spinPhase)) * 0.80 + 0.28
        local swayX  = math.sin(p.swayPhase) * p.swayAmp

        s.container.Position = UDim2.fromScale(p.x + swayX, p.y)
        s.container.Rotation = p.rot
        s.container.Size = UDim2.fromOffset(p.size * wScale, p.size * p.aspect)

        s.highlight.Position = UDim2.fromScale(
            0.5 + math.cos(p.spinPhase) * 0.20,
            0.32
        )
        s.highlight.ImageTransparency = 0.55 + (1 - wScale) * 0.3

        s.feather.BackgroundTransparency = 0.72 + (1 - wScale) * 0.1

        local alpha = 1
        if p.life < 0.7 then alpha = p.life / 0.7
        elseif p.life > p.maxLife - 1.8 then alpha = math.max(0, (p.maxLife - p.life) / 1.8) end

        if alpha < 1 then
            local t = 1 - alpha
            s.highlight.ImageTransparency = math.min(1, 0.55 + t)
            s.innerShadow.ImageTransparency = math.min(1, 0.40 + t)
            s.feather.BackgroundTransparency = math.min(1, 0.72 + t)
            s.wideTop.BackgroundTransparency = t * 0.6
            s.narrowBottom.BackgroundTransparency = t * 0.6
        else
            s.wideTop.BackgroundTransparency = 0
            s.narrowBottom.BackgroundTransparency = 0
        end

        if p.life >= p.maxLife or p.y > 1.22 then
            s.container.Position = UDim2.fromScale(-0.5, -0.5)
            table.insert(petalPool, s)
            table.remove(petalActive, i)
        end
    end
end)

