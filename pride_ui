do
    local dragging, dragStart, startPos
    panel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = panel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInput.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            panel.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

local isOpen = true
local function openPanel()
    if isOpen then return end
    isOpen = true
    panel.Visible = true
    panel.Size = UDim2.fromOffset(PW * 0.9, PH * 0.9)
    tw(panel, 0.32, { Size = UDim2.fromOffset(PW, PH) }, Enum.EasingStyle.Back)
end
local function closePanel()
    if not isOpen then return end
    isOpen = false
    local t = tw(panel, 0.22, { Size = UDim2.fromOffset(PW * 0.9, PH * 0.9) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    t.Completed:Connect(function() panel.Visible = false end)
end

closeBtn.MouseButton1Click:Connect(closePanel)
minBtn.MouseButton1Click:Connect(closePanel)

UserInput.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift or i.KeyCode == Enum.KeyCode.P then
        if isOpen then closePanel() else openPanel() end
    end
end)

