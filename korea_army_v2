-- Combat
local function isAlive(plr)
    return plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character:FindFirstChildOfClass("Humanoid").Health > 0
end

local function getHitPart(char, name)
    return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
end

local function getClosest(fov, teamCheck, visibleCheck, hitPart)
    local closest, dist = nil, fov
    local mousePos = UserInputService:GetMouseLocation()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) then
            if teamCheck and plr.Team == LocalPlayer.Team then continue end
            local part = getHitPart(plr.Character, hitPart)
            if not part then continue end

            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen and not Config.RageWallbang then continue end

            if visibleCheck then
                local origin = Camera.CFrame.Position
                local dir = (part.Position - origin).Unit * 2000
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {LocalPlayer.Character, plr.Character}
                params.FilterType = Enum.RaycastFilterType.Exclude
                if workspace:Raycast(origin, dir, params) then continue end
            end

            local mag = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
            if mag < dist then
                closest = plr
                dist = mag
            end
        end
    end
    return closest
end

local function fireDamage(target)
    if not isAlive(target) then return end
    if math.random(1, 100) > Config.RageHitChance then return end

    local part = getHitPart(target.Character, Config.RageHitPart)
    local root = target.Character.HumanoidRootPart
    if not part or not root then return end

    local dmg = Config.UseCustomDamage and Config.CustomDamage or (9999 * Config.DamageMultiplier)

    if Config.RageWallbang and Remotes.Damage then
        pcall(function()
            Remotes.Damage:FireServer(target.Character, part, dmg, true)
            Remotes.Damage:FireServer(target, dmg)
            Remotes.Damage:FireServer(part, dmg)
        end)
    end
    if Remotes.CastBullet then pcall(function() Remotes.CastBullet:FireServer(part.Position, part, dmg) end) end
    if Remotes.Shoot then pcall(function() Remotes.Shoot:FireServer(part.Position, target.Character) end) end
    if Remotes.FireProjectile then pcall(function() Remotes.FireProjectile:FireServer(part.Position, part.CFrame, dmg) end) end
    if Remotes.Explode then pcall(function() Remotes.Explode:FireServer(root.Position) end) end
end

local function killAll()
    if Remotes.KillAllPlayers then pcall(function() Remotes.KillAllPlayers:FireServer() end) end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) then
            fireDamage(plr)
        end
    end
end

local function giveWeapons()
    local function verify(tool)
        if Remotes.VerifyTool then pcall(function() Remotes.VerifyTool:FireServer(tool) end) end
    end
    for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if t:IsA("Tool") then verify(t) end
    end
    if LocalPlayer.Character then
        for _, t in ipairs(LocalPlayer.Character:GetChildren()) do
            if t:IsA("Tool") then verify(t) end
        end
    end
    if Remotes.RemoteKey then
        pcall(function()
            Remotes.RemoteKey:FireServer("all")
            Remotes.RemoteKey:FireServer("weapons")
            Remotes.RemoteKey:FireServer(true)
        end)
    end
    if Remotes.GetAdmin then pcall(function() Remotes.GetAdmin:InvokeServer() end) end
end

local function enableGod()
    if Remotes.EnableGodMode then pcall(function() Remotes.EnableGodMode:FireServer(true) end) end
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
        end
    end
end

