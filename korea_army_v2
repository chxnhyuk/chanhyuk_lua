-- Main loop (throttled for lag fix)
local lastEspUpdate = 0
local lastChat = 0
local aaAngle = 0

RunService.RenderStepped:Connect(function()
    local now = tick()

    -- ESP every frame is fine if we skip heavy work
    if now - lastEspUpdate > 0.016 then
        updateESP()
        lastEspUpdate = now
    end

    runAimbot()
    antiJailTick()
    updateHitboxes()

    FOVCircle.Position = UserInputService:GetMouseLocation()
    FOVCircle.Radius = Config.RageFOV
    FOVCircle.Color = Config.FOVColor
    FOVCircle.Visible = Config.FOVCircle

    AimFOVCircle.Position = UserInputService:GetMouseLocation()
    AimFOVCircle.Radius = Config.AimbotFOV
    AimFOVCircle.Visible = Config.Aimbot

    if (Config.Ragebot and Config.RageAutoFire) or Config.SilentAim or Config.TriggerBot then
        local t = getClosest(Config.RageFOV, Config.RageTeamCheck, false, Config.RageHitPart)
        if t then fireDamage(t) end
    end

    if Config.Speed and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = Config.SpeedValue end
    end

    if Config.AutoSprint and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            hum.WalkSpeed = math.max(hum.WalkSpeed, 22)
        end
    end

    if Config.InfiniteHealth and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health < math.huge then hum.Health = math.huge end
    end

    if Config.AntiAim and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        aaAngle = aaAngle + Config.AntiAimSpeed
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position) * CFrame.Angles(0, math.rad(aaAngle), 0)
    end

    if Config.Zoom then
        Camera.FieldOfView = Config.ZoomFOV
    end

    if Config.BunnyHop and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.FloorMaterial == Enum.Material.Air then
            -- keep momentum
        elseif hum and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end

    if Config.ChatSpam and now - lastChat > 3 then
        pcall(function()
            local chatRE = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatRE and chatRE:FindFirstChild("SayMessageRequest") then
                chatRE.SayMessageRequest:FireServer(Config.ChatSpamText, "All")
            end
        end)
        lastChat = now
    end
end)

