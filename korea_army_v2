local function getDrawing(class)
    for i, d in ipairs(DrawingPool) do
        if d.__class == class and not d.__used then
            d.__used = true
            return d
        end
    end
    local d = Drawing.new(class)
    d.__class = class
    d.__used = true
    table.insert(DrawingPool, d)
    return d
end

