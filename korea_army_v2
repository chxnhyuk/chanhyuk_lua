local function antiCheatBypass()
    -- common detection spoof
    pcall(function()
        local mt = getrawmetatable(game)
        if mt then
            setreadonly(mt, false)
            local old = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if method == "Kick" or method == "Ban" or method == "Destroy" then
                    if self == LocalPlayer or self == LocalPlayer.Character then
                        return
                    end
                end
                if method == "FireServer" or method == "InvokeServer" then
                    local args = {...}
                    -- block common anti-cheat reports
                    if typeof(args[1]) == "string" and (
                        string.find(string.lower(args[1]), "cheat") or
                        string.find(string.lower(args[1]), "exploit") or
                        string.find(string.lower(args[1]), "hack") or
                        string.find(string.lower(args[1]), "detect")
                    ) then
                        return
                    end
                end
                return old(self, ...)
            end)
            setreadonly(mt, true)
        end
    end)

    -- hide script from common scanners
    pcall(function()
        if syn and syn.protect_gui then
            -- already protected by linoria
        end
    end)

    -- spoof walkspeed / jumppower changes
    local oldWS, oldJP = 16, 50
    RunService.Heartbeat:Connect(function()
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                if hum.WalkSpeed ~= oldWS and not Config.Speed then
                    oldWS = hum.WalkSpeed
                end
                if hum.JumpPower ~= oldJP and not Config.InfiniteJump then
                    oldJP = hum.JumpPower
                end
            end
        end
    end)
end
