local function runAimbot()
    if not Config.Aimbot or not aiming then return end
    local target = getClosest(Config.AimbotFOV, Config.AimbotTeamCheck, Config.AimbotVisibleCheck, Config.AimbotHitPart)
    if not target then return end
    local part = getHitPart(target.Character, Config.AimbotHitPart)
    if not part then return end
    local goal = CFrame.new(Camera.CFrame.Position, part.Position)
    Camera.CFrame = Camera.CFrame:Lerp(goal, Config.AimbotSmooth)
end

-- Fly
local flying = false
local flyBV = nil
local flyBG = nil

local function toggleFly(state)
    flying = state

    if flyBV then
        pcall(function() flyBV:Destroy() end)
        flyBV = nil
    end
    if flyBG then
        pcall(function() flyBG:Destroy() end)
        flyBG = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep("OnyxFly")
    end)

    if not flying then return end
    if not LocalPlayer.Character then return end

    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = root

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.Parent = root

    RunService:BindToRenderStep("OnyxFly", Enum.RenderPriority.Camera.Value, function()
        if not flying or not root or not root.Parent then
            toggleFly(false)
            return
        end
        flyBG.CFrame = Camera.CFrame
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end

        if dir.Magnitude > 0 then
            flyBV.Velocity = dir.Unit * Config.FlySpeed
        else
            flyBV.Velocity = Vector3.zero
        end
    end)
end

-- Noclip
local noclipConn = nil

local function toggleNoclip(state)
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    if state then
        noclipConn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanCollide = false
                    end
                end
            end
        end)
    end
end

-- Anti Jail (동굴부대)
local lastSafe = CFrame.new(0, 50, 0)

local function antiJailTick()
    if not Config.AntiJail then return end
    if not LocalPlayer.Character then return end

    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    local pos = root.Position
    if pos.Y < -25 or pos.Y > 380 or (pos - lastSafe.Position).Magnitude > 280 then
        root.CFrame = lastSafe
        hum.Health = math.huge
        enableGod()
    else
        lastSafe = root.CFrame
    end

    if hum.Health < 80 then
        hum.Health = math.huge
    end
end

