local rainbowHue = 0
local function updateESP()
    rainbowHue = (rainbowHue + 0.005) % 1
    local rainbow = Color3.fromHSV(rainbowHue, 1, 1)

    for plr, d in pairs(ESPObjects) do
        if not plr.Parent or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
            d.Box.Visible = false
            d.Name.Visible = false
            d.Health.Visible = false
            d.Distance.Visible = false
            d.Weapon.Visible = false
            d.Tracer.Visible = false
            d.Snap.Visible = false
            d.Arrow.Visible = false
            d.Hat.Visible = false
            d.Cham.Enabled = false
            continue
        end

        local root = plr.Character.HumanoidRootPart
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        local col = Config.RainbowESP and rainbow or Config.BoxColor

        if Config.ESP and onScreen then
            local scale = (root.Size.Y * 3 / math.max(pos.Z, 1)) * 90

            if Config.BoxESP then
                d.Box.Size = Vector2.new(scale * 0.65, scale * 1.3)
                d.Box.Position = Vector2.new(pos.X - d.Box.Size.X / 2, pos.Y - d.Box.Size.Y / 2)
                d.Box.Color = col
                d.Box.Visible = true
            else
                d.Box.Visible = false
            end

            if Config.NameESP then
                d.Name.Text = plr.DisplayName
                d.Name.Position = Vector2.new(pos.X, pos.Y - scale * 0.8)
                d.Name.Color = col
                d.Name.Visible = true
            else
                d.Name.Visible = false
            end

            if Config.HealthESP and hum then
                local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                d.Health.Text = math.floor(hum.Health) .. "hp"
                d.Health.Position = Vector2.new(pos.X, pos.Y + scale * 0.5)
                d.Health.Color = Color3.fromRGB(255 - ratio * 255, ratio * 255, 0)
                d.Health.Visible = true
            else
                d.Health.Visible = false
            end

            if Config.DistanceESP then
                d.Distance.Text = math.floor(dist) .. "m"
                d.Distance.Position = Vector2.new(pos.X, pos.Y + scale * 0.7)
                d.Distance.Visible = true
            else
                d.Distance.Visible = false
            end

            if Config.WeaponESP then
                d.Weapon.Text = getWeaponName(plr)
                d.Weapon.Position = Vector2.new(pos.X, pos.Y + scale * 0.9)
                d.Weapon.Visible = true
            else
                d.Weapon.Visible = false
            end

            if Config.TracerESP then
                local from = Config.TracerOrigin == "Bottom"
                    and Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                d.Tracer.From = from
                d.Tracer.To = Vector2.new(pos.X, pos.Y)
                d.Tracer.Color = col
                d.Tracer.Visible = true
            else
                d.Tracer.Visible = false
            end

            if Config.Snaplines then
                d.Snap.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                d.Snap.To = Vector2.new(pos.X, pos.Y)
                d.Snap.Color = col
                d.Snap.Visible = true
            else
                d.Snap.Visible = false
            end

            if Config.ChinaHat then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local hpos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.75, 0))
                    d.Hat.Position = Vector2.new(hpos.X, hpos.Y)
                    d.Hat.Radius = scale * 0.3
                    d.Hat.Color = col
                    d.Hat.Visible = true
                end
            else
                d.Hat.Visible = false
            end
        else
            d.Box.Visible = false
            d.Name.Visible = false
            d.Health.Visible = false
            d.Distance.Visible = false
            d.Weapon.Visible = false
            d.Tracer.Visible = false
            d.Snap.Visible = false
            d.Hat.Visible = false

            -- offscreen arrows
            if Config.OffscreenArrows and Config.ESP then
                local screen = Camera.ViewportSize
                local dir = (root.Position - Camera.CFrame.Position).Unit
                local dot = Camera.CFrame.LookVector:Dot(dir)
                if dot < 0.7 then
                    local x = screen.X / 2 + dir.X * 150
                    local y = screen.Y / 2 - dir.Y * 150
                    d.Arrow.PointA = Vector2.new(x, y - 10)
                    d.Arrow.PointB = Vector2.new(x - 8, y + 8)
                    d.Arrow.PointC = Vector2.new(x + 8, y + 8)
                    d.Arrow.Color = col
                    d.Arrow.Visible = true
                else
                    d.Arrow.Visible = false
                end
            else
                d.Arrow.Visible = false
            end
        end

        if Config.Chams then
            d.Cham.Adornee = plr.Character
            d.Cham.FillColor = Config.RainbowESP and rainbow or Config.ChamsFill
            d.Cham.OutlineColor = Config.ChamsOutline
            d.Cham.Enabled = true
        else
            d.Cham.Enabled = false
        end
    end
end

